# Переменные окружения для docker-compose (скопируйте в .env рядом с этим файлом)

# --- Postgres ---
POSTGRES_DB=course
POSTGRES_USER=course
POSTGRES_PASSWORD=course

# --- Django backend ---
SECRET_KEY=change-me-in-production
DEBUG=False
FRONTEND_URL=http://localhost
SEED_DEMO=False

# --- Почта (по умолчанию письма пишутся в консоль контейнера backend) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@course.local
